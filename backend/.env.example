# Clerk (required) – get from Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase (required) – Project Settings → API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: AI (POST /api/solve)
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: port (default 3001)
PORT=3001

# Optional: Stripe (Studly Pro)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRODUCT_ID_PRO_MONTHLY=prod_xxx
STRIPE_PRODUCT_ID_PRO_YEARLY=prod_xxx
STRIPE_PRODUCT_ID_PRO_DISCOUNT=prod_xxx

# Optional: production CORS (comma-separated origins; if unset, all origins allowed)
# ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com

# Optional: web search for AI (serper.dev)
SERPER_API_KEY=xxx

# Optional: free tier daily question limit (default 10)
FREE_DAILY_QUESTION_LIMIT=10
