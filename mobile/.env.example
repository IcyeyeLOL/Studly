# ===========================================
# Studly – where to put API keys
# ===========================================
# Copy this file to .env and fill in real values.
# Never commit .env (it's in .gitignore).

# ---------- MOBILE APP (Expo) – mobile/.env ----------
# Only PUBLIC keys go here. These get bundled into the app.
# Do NOT put secret keys (Clerk secret, Supabase service role, AI key) here.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Supabase (public anon key only – safe for client)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx

# Backend API URL (required for real AI solutions)
# Use http://localhost:3001 for emulator; for physical device use your computer's LAN IP, e.g. http://10.2.80.65:3001
# EXPO_PUBLIC_API_URL=http://localhost:3001

# ---------- BACKEND (API server) – backend/.env ----------
# Create a backend folder (e.g. Next.js or Node) and put SECRET keys there only.
# Never expose these in the mobile app.

# CLERK_SECRET_KEY=sk_test_xxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# Or OPENAI_API_KEY=sk-xxxx if you use OpenAI
